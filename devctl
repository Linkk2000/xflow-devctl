#!/usr/bin/env bash
# XFlow devctl - user-level entrypoint.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OPS="$ROOT"
if [[ -z "${DEVCTL_REPO_ROOT:-}" ]]; then
  if repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    DEVCTL_REPO_ROOT="$repo_root"
  else
    DEVCTL_REPO_ROOT="$(pwd)"
  fi
fi
export DEVCTL_TOOL_ROOT="$ROOT"
export DEVCTL_REPO_ROOT
export DEVCTL_OPS_ROOT="$OPS"

case "${1:-help}" in
  -h|--help|help|check|git|issue|preflight|approval|rules|migrate)
    export DEVCTL_SKIP_PROVIDER_LOAD=1
    ;;
esac

# shellcheck source=lib/common.sh
source "$OPS/lib/common.sh"

usage() {
  cat "$OPS/help.txt"
}

run_script() {
  local script="$1"
  shift
  [[ -x "$script" || -f "$script" ]] || devctl_die "missing script: $script"
  exec bash "$script" "$@"
}

run_python() {
  export PYTHONDONTWRITEBYTECODE=1
  export PYTHONPATH="$OPS${PYTHONPATH:+:$PYTHONPATH}"
  exec python -m xflow "$@"
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi

  case "$1" in
    -h|--help|help)
      usage
      ;;
    preflight|approval|rules|migrate)
      run_python "$@"
      ;;
    git)
      shift
      [[ $# -ge 1 ]] || { usage; exit 1; }
      case "$1" in
        start)      shift; run_script "$OPS/git/start.sh" "$@" ;;
        commit-msg) shift; run_script "$OPS/git/commit-msg.sh" "$@" ;;
        mr|pr-get)  run_python git "$@" ;;
        done)       shift; run_script "$OPS/git/done.sh" "$@" ;;
        status)     shift; run_script "$OPS/git/status.sh" "$@" ;;
        *) devctl_die "unknown git subcommand: $1 (devctl help)" ;;
      esac
      ;;
    issue)
      shift
      [[ $# -ge 1 ]] || { usage; exit 1; }
      run_python issue "$@"
      ;;
    check)
      shift
      [[ $# -ge 1 ]] || { usage; exit 1; }
      run_python check "$@"
      ;;
    app)
      shift
      [[ $# -ge 1 ]] || { usage; exit 1; }
      case "$1" in
        start-frontend) shift; run_script "$OPS/app/start-frontend.sh" "$@" ;;
        stop-frontend)  shift; run_script "$OPS/app/stop-frontend.sh" "$@" ;;
        status)         shift; run_script "$OPS/app/status.sh" "$@" ;;
        *) devctl_die "unknown app subcommand: $1 (devctl help)" ;;
      esac
      ;;
    *)
      devctl_die "unknown command: $1 (devctl help)"
      ;;
  esac
}

main "$@"
