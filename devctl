#!/usr/bin/env bash
# XFlow devctl - user-level entrypoint.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OPS="$ROOT"
if [[ -z "${DEVCTL_REPO_ROOT:-}" ]]; then
  if repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    DEVCTL_REPO_ROOT="$repo_root"
  else
    DEVCTL_REPO_ROOT="$(pwd)"
  fi
fi
export DEVCTL_TOOL_ROOT="$ROOT"
export DEVCTL_REPO_ROOT
export DEVCTL_OPS_ROOT="$OPS"

# shellcheck source=lib/common.sh
source "$OPS/lib/common.sh"

usage() {
  cat "$OPS/help.txt"
}

run_script() {
  local script="$1"
  shift
  [[ -x "$script" || -f "$script" ]] || devctl_die "缺少脚本: $script"
  exec bash "$script" "$@"
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi

  case "$1" in
    -h|--help|help)
      usage
      ;;
    git)
      shift
      [[ $# -ge 1 ]] || { usage; exit 1; }
      case "$1" in
        start)      shift; run_script "$OPS/git/start.sh" "$@" ;;
        commit-msg) shift; run_script "$OPS/git/commit-msg.sh" "$@" ;;
        mr)         shift; run_script "$OPS/git/mr.sh" "$@" ;;
        done)       shift; run_script "$OPS/git/done.sh" "$@" ;;
        status)     shift; run_script "$OPS/git/status.sh" "$@" ;;
        *) devctl_die "未知 git 子命令: $1（devctl help）" ;;
      esac
      ;;
    issue)
      shift
      [[ $# -ge 1 ]] || { usage; exit 1; }
      case "$1" in
        create)  shift; run_script "$OPS/issue/create.sh" "$@" ;;
        list)    shift; run_script "$OPS/issue/list.sh" "$@" ;;
        show)    shift; run_script "$OPS/issue/show.sh" "$@" ;;
        comment) shift; run_script "$OPS/issue/comment.sh" "$@" ;;
        close)   shift; run_script "$OPS/issue/close.sh" "$@" ;;
        *) devctl_die "未知 issue 子命令: $1（devctl help）" ;;
      esac
      ;;
    check)
      shift
      [[ $# -ge 1 ]] || { usage; exit 1; }
      case "$1" in
        academic-issue) shift; run_script "$OPS/check/academic-issue.sh" "$@" ;;
        academic-mr)    shift; run_script "$OPS/check/academic-mr.sh" "$@" ;;
        claude-package) shift; run_script "$OPS/check/claude-package.sh" "$@" ;;
        local-review)   shift; run_script "$OPS/check/local-review.sh" "$@" ;;
        tdd-result)     shift; run_script "$OPS/check/tdd-result.sh" "$@" ;;
        *) devctl_die "unknown check subcommand: $1 (devctl help)" ;;
      esac
      ;;
    app)
      shift
      [[ $# -ge 1 ]] || { usage; exit 1; }
      case "$1" in
        start-frontend) shift; run_script "$OPS/app/start-frontend.sh" "$@" ;;
        stop-frontend)  shift; run_script "$OPS/app/stop-frontend.sh" "$@" ;;
        status)         shift; run_script "$OPS/app/status.sh" "$@" ;;
        *) devctl_die "unknown app subcommand: $1 (devctl help)" ;;
      esac
      ;;
    run)
      shift
      run_script "$OPS/run.sh" "$@"
      ;;
    *)
      devctl_die "未知命令: $1（devctl help）"
      ;;
  esac
}

main "$@"
