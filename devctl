#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
select_python() {
  for candidate in "${DEVCTL_PYTHON:-}" python3 python; do
    [ -n "$candidate" ] || continue
    command -v "$candidate" >/dev/null 2>&1 || [ -x "$candidate" ] || continue
    "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1 || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

PYTHON=$(select_python) || {
  printf '%s\n' '[ERROR] devctl requires Python 3.9+; set DEVCTL_PYTHON.' >&2
  exit 1
}
mark_provider_skip_for_command() {
  scan_command=help
  scan_value=
  scan_after_options=
  for scan_arg in "$@"; do
    if [ -n "$scan_value" ]; then
      scan_value=
      continue
    fi
    if [ -n "$scan_after_options" ]; then
      scan_command="$scan_arg"
      break
    fi
    case "$scan_arg" in
      --profile|--cockpit-root|--repo)
        scan_value=1
        ;;
      --profile=*|--cockpit-root=*|--repo=*)
        ;;
      --)
        scan_after_options=1
        ;;
      -h|--help|help|check|git|issue|preflight|approval|attachment|rules|migrate|unattended|task|contract|trace)
        scan_command="$scan_arg"
        break
        ;;
      -*)
        break
        ;;
      *)
        scan_command="$scan_arg"
        break
        ;;
    esac
  done
  case "$scan_command" in
    -h|--help|help|check|git|issue|preflight|approval|attachment|rules|migrate|unattended|task|contract|trace)
      export DEVCTL_SKIP_PROVIDER_LOAD=1
      ;;
  esac
}
mark_provider_skip_for_command "$@"
if [ -n "${DEVCTL_REPO_ROOT:-}" ]; then
  REPO_ROOT=$DEVCTL_REPO_ROOT
else
  REPO_ROOT=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) || REPO_ROOT=$PWD
  if [ -d "$REPO_ROOT" ]; then
    REPO_ROOT=$(CDPATH= cd -- "$REPO_ROOT" && pwd -P)
  fi
fi
export DEVCTL_TOOL_ROOT="$ROOT" DEVCTL_OPS_ROOT="$ROOT" PYTHONDONTWRITEBYTECODE=1
export DEVCTL_REPO_ROOT="$REPO_ROOT"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m xflow "$@"
