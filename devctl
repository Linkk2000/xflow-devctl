#!/usr/bin/env bash
# XFlow devctl - user-level entrypoint.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OPS="$ROOT"
if [[ -z "${DEVCTL_REPO_ROOT:-}" ]]; then
  if repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    DEVCTL_REPO_ROOT="$repo_root"
  else
    DEVCTL_REPO_ROOT="$(pwd)"
  fi
fi
export DEVCTL_TOOL_ROOT="$ROOT"
export DEVCTL_REPO_ROOT
export DEVCTL_OPS_ROOT="$OPS"

case "${1:-help}" in
  -h|--help|help|check|git|issue|preflight|approval|attachment|rules|migrate|app)
    export DEVCTL_SKIP_PROVIDER_LOAD=1
    ;;
esac

# shellcheck source=lib/common.sh
source "$OPS/lib/common.sh"

usage() {
  cat "$OPS/help.txt"
}

run_python() {
  export PYTHONDONTWRITEBYTECODE=1
  export PYTHONPATH="$OPS${PYTHONPATH:+:$PYTHONPATH}"
  exec python -m xflow "$@"
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi

  case "$1" in
    -h|--help|help)
      usage
      ;;
    preflight|approval|attachment|rules|migrate|app)
      run_python "$@"
      ;;
    git)
      shift
      [[ $# -ge 1 ]] || { usage; exit 1; }
      run_python git "$@"
      ;;
    issue)
      shift
      [[ $# -ge 1 ]] || { usage; exit 1; }
      run_python issue "$@"
      ;;
    check)
      shift
      [[ $# -ge 1 ]] || { usage; exit 1; }
      run_python check "$@"
      ;;
    *)
      devctl_die "unknown command: $1 (devctl help)"
      ;;
  esac
}

main "$@"
