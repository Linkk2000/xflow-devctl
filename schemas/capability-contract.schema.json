{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xflow.dev/schemas/capability-contract.schema.json",
  "title": "XFlow Capability Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "status", "created", "note", "capabilityContract", "semanticValueContracts", "failureReasonContracts", "context", "contextRoles", "interactionContracts", "verificationMatrix", "engineeringProjections", "dependsOn", "preconditionsToResolve", "futureCapabilitiesOutOfScope", "references"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/semver"},
    "name": {"$ref": "#/$defs/text"},
    "status": {"enum": ["draft", "accepted-design", "active", "deprecated"]},
    "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(?![\\s\\S])", "format": "date"},
    "note": {"$ref": "#/$defs/text"},
    "capabilityContract": {"$ref": "#/$defs/capability"},
    "semanticValueContracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/semanticValue"}},
    "failureReasonContracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/failureReason"}},
    "context": {"$ref": "#/$defs/context"},
    "contextRoles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contextRole"}},
    "interactionContracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interaction"}},
    "verificationMatrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/verification"}},
    "engineeringProjections": {"type": "array", "items": {"$ref": "#/$defs/projection"}},
    "dependsOn": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "preconditionsToResolve": {"type": "array", "items": {"$ref": "#/$defs/precondition"}},
    "futureCapabilitiesOutOfScope": {"type": "array", "items": {"$ref": "#/$defs/futureCapability"}},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:na|none|placeholder|tbd|todo|unknown)(?![\\s\\S]))[a-z0-9]+(?:[.-][a-z0-9]+)*(?![\\s\\S])"
    },
    "semver": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?![\\s\\S])"},
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:-|[Nn]/[Aa]|[Nn][Aa]|[Nn][Oo][Nn][Ee]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr]|[Tt][Bb][Dd]|[Tt][Oo][Dd][Oo]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|待定|待补充|占位)(?![\\s\\S]))\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
    },
    "idList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "textList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "objectBase": {"type": "object", "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "supersedes": {"$ref": "#/$defs/idList"}}},
    "constraint": {"allOf": [{"$ref": "#/$defs/objectBase"}, {"required": ["id", "version", "rule"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "rule": {"$ref": "#/$defs/text"}, "supersedes": {"$ref": "#/$defs/idList"}}}]},
    "capability": {"allOf": [{"$ref": "#/$defs/objectBase"}, {"required": ["id", "version", "purpose", "participants", "inputs", "outputs", "constraints"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "purpose": {"$ref": "#/$defs/text"}, "participants": {"$ref": "#/$defs/idList"}, "inputs": {"$ref": "#/$defs/idList"}, "outputs": {"$ref": "#/$defs/idList"}, "constraints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/constraint"}}, "supersedes": {"$ref": "#/$defs/idList"}}}]},
    "semanticValue": {"$ref": "#/$defs/namedMeaning"},
    "namedMeaning": {"allOf": [{"$ref": "#/$defs/objectBase"}, {"required": ["id", "version", "name", "meanings"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "name": {"$ref": "#/$defs/text"}, "meanings": {"$ref": "#/$defs/textList"}, "supersedes": {"$ref": "#/$defs/idList"}}}]},
    "failureReason": {"allOf": [{"$ref": "#/$defs/objectBase"}, {"required": ["id", "version", "code", "meaning", "preserves"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "code": {"$ref": "#/$defs/text"}, "meaning": {"$ref": "#/$defs/text"}, "preserves": {"$ref": "#/$defs/textList"}, "supersedes": {"$ref": "#/$defs/idList"}}}]},
    "context": {"allOf": [{"$ref": "#/$defs/objectBase"}, {"required": ["id", "version", "name", "entryConditions", "completionConditions", "responsibilities"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "name": {"$ref": "#/$defs/text"}, "entryConditions": {"$ref": "#/$defs/textList"}, "completionConditions": {"$ref": "#/$defs/textList"}, "responsibilities": {"$ref": "#/$defs/textList"}, "supersedes": {"$ref": "#/$defs/idList"}}}]},
    "contextRole": {"allOf": [{"$ref": "#/$defs/objectBase"}, {"required": ["id", "version", "context", "responsibility", "doesNotOwn"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "context": {"$ref": "#/$defs/id"}, "responsibility": {"$ref": "#/$defs/text"}, "doesNotOwn": {"$ref": "#/$defs/textList"}, "supersedes": {"$ref": "#/$defs/idList"}}}]},
    "interaction": {"allOf": [{"$ref": "#/$defs/objectBase"}, {"required": ["id", "version", "context", "participants", "accepts", "produces", "constraints", "failureExpectations"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "context": {"$ref": "#/$defs/id"}, "participants": {"$ref": "#/$defs/idList"}, "accepts": {"$ref": "#/$defs/idList"}, "produces": {"$ref": "#/$defs/idList"}, "constraints": {"$ref": "#/$defs/idList"}, "failureExpectations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["reason", "preserves"], "properties": {"reason": {"$ref": "#/$defs/id"}, "preserves": {"$ref": "#/$defs/textList"}}}}, "supersedes": {"$ref": "#/$defs/idList"}}}]},
    "verification": {"allOf": [{"$ref": "#/$defs/objectBase"}, {"required": ["id", "version", "traces", "given", "when", "then", "verifyBy"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "traces": {"$ref": "#/$defs/idList"}, "given": {"$ref": "#/$defs/text"}, "when": {"$ref": "#/$defs/text"}, "then": {"$ref": "#/$defs/text"}, "verifyBy": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": {"type": {"$ref": "#/$defs/text"}, "target": {"$ref": "#/$defs/text"}}}}, "supersedes": {"$ref": "#/$defs/idList"}}}]},
    "projection": {"allOf": [{"$ref": "#/$defs/objectBase"}, {"required": ["id", "version", "traces", "authorityRepresentation", "derivedRepresentations", "transformationBoundary", "preservedInvariants"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "traces": {"$ref": "#/$defs/idList"}, "authorityRepresentation": {"$ref": "#/$defs/text"}, "derivedRepresentations": {"$ref": "#/$defs/textList"}, "transformationBoundary": {"$ref": "#/$defs/text"}, "preservedInvariants": {"$ref": "#/$defs/idList"}, "supersedes": {"$ref": "#/$defs/idList"}}}]},
    "dependency": {"allOf": [{"$ref": "#/$defs/objectBase"}, {"required": ["id", "version", "contract", "requiredFor", "ownerRepository"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "contract": {"$ref": "#/$defs/id"}, "requiredFor": {"$ref": "#/$defs/idList"}, "ownerRepository": {"$ref": "#/$defs/text"}, "supersedes": {"$ref": "#/$defs/idList"}}}]},
    "precondition": {"allOf": [{"$ref": "#/$defs/objectBase"}, {"required": ["id", "version", "question", "requiredBefore", "status", "decision"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "question": {"$ref": "#/$defs/text"}, "requiredBefore": {"enum": ["accepted-design", "engineering-projection", "implementation", "never"]}, "status": {"enum": ["open", "deferred", "resolved"]}, "decision": {"$ref": "#/$defs/text"}, "supersedes": {"$ref": "#/$defs/idList"}}}]},
    "futureCapability": {"allOf": [{"$ref": "#/$defs/objectBase"}, {"required": ["id", "version", "capability", "reason"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver"}, "capability": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}, "supersedes": {"$ref": "#/$defs/idList"}}}]},
    "reference": {"type": "object", "additionalProperties": false, "required": ["kind", "target", "note"], "properties": {"kind": {"$ref": "#/$defs/text"}, "target": {"$ref": "#/$defs/text"}, "note": {"$ref": "#/$defs/text"}}}
  }
}
